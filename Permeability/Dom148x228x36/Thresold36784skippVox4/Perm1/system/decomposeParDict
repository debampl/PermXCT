FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      decomposeParDict;
}

//*************************UPDATE TOPO STE DICT *****************************//
//*** Assign the processor division and restrict the all the interface simulation to perform in a single patch ***//\n


numberOfSubdomains      16;     // # of CPU cores

