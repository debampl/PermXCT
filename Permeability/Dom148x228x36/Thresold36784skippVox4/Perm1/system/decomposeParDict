    // Keep owner and neighbour of baffles on the same processor
    // (ie, keep it detectable as a baffles).
    // Baffles are two boundary face sharing the same points
    baffles
    {
        type        preserveBaffles;
        enabled     false;
    }

    // Keep owned and neighbour on same processor for faces in zones
    faces
    {
        type        preserveFaceZones;
        zones       (".*");
        enables     false;
    }

    // Keep owner and neighbour on same processor for faces in patches
